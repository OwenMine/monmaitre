# ============================================
# .gitattributes — MON MAÎTRE
# ============================================
# Normalise automatiquement les fins de ligne
# lors du commit (LF) et du checkout (CRLF sur Windows)

* text=auto eol=lf

# Fichiers Windows spécifiques
*.bat text eol=crlf
*.cmd text eol=crlf

# Fichiers binaires (à ne pas modifier)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary

# Fichiers de config
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Ne pas diff sur ces fichiers
composer.lock -diff
package-lock.json -diff